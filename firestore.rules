rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if project exists and user is a member
    function isProjectMember(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Helper: check if project exists and user is the owner
    function isProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    match /workspaces/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /projects/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Updates:
      // 1. Owner can modify all project attributes.
      // 2. Non-owners (joining/leaving or member synchronization) can ONLY touch 'members' and 'memberUids',
      //    and can NEVER change userId, workspaceId, or project properties.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.workspaceId == resource.data.workspaceId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
        )
      );
      // Only project owner can delete project
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /tickets/{id} {
      allow read: if request.auth != null;
      // Ticket creation: only project owner or confirmed member
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId &&
        (isProjectOwner(request.resource.data.projectId) || isProjectMember(request.resource.data.projectId));
      // Ticket updates: only creator, project owner, or project member
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isProjectOwner(resource.data.projectId) ||
        isProjectMember(resource.data.projectId)
      );
      // Ticket deletion: only creator, project owner, or project member
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isProjectOwner(resource.data.projectId) ||
        isProjectMember(resource.data.projectId)
      );

      match /files/{fileId} {
        allow read, write: if request.auth != null;
      }
      match /activity/{activityId} {
        allow read, write: if request.auth != null;
      }
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }

    // Trigger Email extension: protected against email spam flooding and data leak
    match /mail/{id} {
      // Authenticated users can only queue valid, bounded emails
      allow create: if request.auth != null
        && request.resource.data.to is list
        && request.resource.data.to.size() >= 1
        && request.resource.data.to.size() <= 10
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html is string
        && request.resource.data.message.html.size() <= 50000;
      // Clients must never read, update, or delete queued emails (Admin SDK processes delivery)
      allow read, update, delete: if false;
    }

    // Error logs
    match /logs/{id} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
