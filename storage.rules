rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Ticket files & comment images: max 10MB per file
    match /tickets/{ticketId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // User avatars: max 2MB, image only, only owner can upload or delete
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback: deny all other paths to prevent unauthorized bucket write attacks
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

